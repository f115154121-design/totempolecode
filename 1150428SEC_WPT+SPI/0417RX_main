    memcpy(&RamfuncsRunStart, &RamfuncsLoadStart, (Uint32)&RamfuncsLoadSize);
    InitFlash();
    InitGpio();
    InitAdc();
    InitEPwm();
    InitCpuTimers();

    while (SFO() == 0)
    {

    }

    int status;
    status = SFO();
    if(status==2) {ESTOP0;}

    EALLOW;
    SysCtrlRegs.PCLKCR0.bit.TBCLKSYNC  = 0;
    EDIS;

    EALLOW;
    PieVectTable.EPWM1_INT = &EPWM1_ISR;
    EDIS;

    PieCtrlRegs.PIECTRL.bit.ENPIE = 1;
    PieCtrlRegs.PIEIER3.bit.INTx1 = 1;  //ePWM1中斷
    IER |= M_INT3;
    IER |= M_INT1;

    EINT;
    ERTM;

    Adc();
    eCAP1();
    GPIO_32();
    GPIO_18();
    GPIO_14();
    EPWM_S5S6();
    EPWM_S7S8();

    EALLOW;
    EPwm1Regs.AQCSFRC.bit.CSFA = 1;
    EPwm1Regs.AQCSFRC.bit.CSFB = 1;
    EPwm2Regs.AQCSFRC.bit.CSFA = 2;
    EPwm2Regs.AQCSFRC.bit.CSFB = 2;
    EDIS;

    EALLOW;
    SysCtrlRegs.PCLKCR0.bit.TBCLKSYNC = 1;
    EDIS;


    for(;;)
    {
        drx = (((phi1-delta_alpha+11)*100) / (last_hardware_prd));
        alpha = (((d1 + 21 + a1) *180)/ last_hardware_prd );
        ZVS = (phi1 > (float)d1);
    }
}

interrupt void EPWM1_ISR(void)
{
    GpioDataRegs.GPASET.bit.GPIO19 = 1;

    Iout = AdcResult.ADCRESULT5;
    Vout = AdcResult.ADCRESULT4;

    Iout_adc = AdcResult.ADCRESULT5 - 1991;
    Vout_adc = AdcResult.ADCRESULT4 - 7;
    Adc_LPF();
    Iout_real = Iout_adc_LPF * 0.016296;
    Vout_real = Vout_adc_LPF * 0.02125;


    // --- 保護 (state = 1) ---
    if (((Iout_filt > 1) && (Iout_filt < 400)) || (Vout > 3000))	//約-24A、63.6V
    {
        EALLOW;
        EPwm1Regs.AQCSFRC.bit.CSFA = 1;
        EPwm1Regs.AQCSFRC.bit.CSFB = 1;
        EPwm2Regs.AQCSFRC.bit.CSFA = 2;
        EPwm2Regs.AQCSFRC.bit.CSFB = 2;
        GpioDataRegs.GPACLEAR.bit.GPIO18 = 1; // 關閉一次側
        EDIS;
        if ((Iout_filt > 1) && (Iout_filt < 400))
        {
            Ierror = 1;
        }
        if (Vout > 3000)
        {
            Verror = 1;
        }
        duty_enable = 0;
        state = 1;
    }

    // --- 2. 控制區塊 ---
    if (state != 1)
    {
        // === 失去同步訊號 待機狀態===
        if ((ECap1Regs.TSCTR > 2000))
        {
            EALLOW;
            EPwm1Regs.AQCSFRC.bit.CSFA = 1;
            EPwm1Regs.AQCSFRC.bit.CSFB = 1;
            EPwm2Regs.AQCSFRC.bit.CSFA = 2;
            EPwm2Regs.AQCSFRC.bit.CSFB = 2;
            EDIS;

            duty_enable = 0;
            state = 2;
            sync_step = 0;
            d1 = 0;
            duty_now = 0;
            EPwm1Regs.TBPHS.half.TBPHS = 0;
            EPwm2Regs.TBPHS.half.TBPHS = 0;

            // 重置計算變數
            duty_count = 0;
        }
        // === 工作狀態 ===
        else
        {
            f_cal();
            p_cal();
            // 同步邏輯 (轉成外部同步)
            if (sync_step == 0)
            {
                EALLOW;
                EPwm1Regs.TBPRD = last_hardware_prd;
                EPwm2Regs.TBPRD = last_hardware_prd;
                EPwm1Regs.TBCTL.bit.PHSEN = 1;
                EPwm2Regs.TBCTL.bit.PHSEN = 1;
                EDIS;
                sync_step = 1;
            }
            // 狀態機
            switch (state)
            {
                case 2:
                    if(GpioDataRegs.GPADAT.bit.GPIO14 == 0)
                    {
                        duty_enable = 1;
                        state = 3; //進入控制模式
                        EALLOW;
                        EPwm1Regs.AQCSFRC.all = 0;
                        EPwm2Regs.AQCSFRC.all = 0;
                        EDIS;
                    }
                    break;

                case 3:
                    if (++duty_count >= duty_deg)
                    {
                        duty_count = 0;
                        if (duty_now < 0.83) duty_now += 0.01; //
                        //else state = 4;
                    }
                    break;

                case 4:
                    if (++pi_count >= pi_deg)
                    {
                        pi_count = 0;
                        if (Rerf_I < Iout_filt) duty_now += 0.005f;
                        else if (Rerf_I > Iout_filt) duty_now -= 0.005f;

                        if (duty_now > 1.0f) duty_now = 1.0f;
                        if (duty_now < 0.2f) duty_now = 0.2f;
                    }
                    break;

            }
            // 更新相位暫存器 (只在訊號正常時更新)
            phi1 = (d1-((1.0f-duty_now)*d1)+a1);
            phi2 = (d1+((1.0f-duty_now)*d1)+a1);
            EPwm1Regs.TBPHS.half.TBPHS = phi1;
            EPwm2Regs.TBPHS.half.TBPHS = phi2;


        }
    }

    EPwm1Regs.ETCLR.bit.INT = 1;
    PieCtrlRegs.PIEACK.all = PIEACK_GROUP3;

    GpioDataRegs.GPACLEAR.bit.GPIO19 = 1;
}
void f_cal(void)
{
    if (ECap1Regs.TSCTR > 2000)
    {
        return;
    }
    //1.取樣頻率
    a = ECap1Regs.CAP2;
    b = f_buf[0];
    c = f_buf[1];

    //2.突波濾除
    if ((a <= b && b <= c) || (c <= b && b <= a))
    {
        d = b;
    }
    else if ((b <= a && a <= c) || (c <= a && a <= b))
    {
        d = a;
    }
    else
    {
        d = c;
    }
        f_buf[1] = b;
        f_buf[0] = a;
    //3.一階低通濾波
    f_filt += (alpha_f * (float)(d - f_filt));
    new_prd = (Uint16)(f_filt * 0.5f);

    //4.變頻率
    if (++f_count >= 1)
    {
        f_count = 0;
        // 1. 如果新計算的值比目前硬體值大，步長加 1
        if (new_prd > last_hardware_prd)
        {
           last_hardware_prd += 1;

        }
        // 2. 如果新計算的值比目前硬體值小，步長減 1
        if (new_prd < last_hardware_prd)
        {
           last_hardware_prd -= 1;
        }
        EALLOW;
        EPwm1Regs.TBPRD = last_hardware_prd;
        EPwm2Regs.TBPRD = last_hardware_prd;
        EPwm1Regs.CMPA.half.CMPA       = (last_hardware_prd >> 1);
        EPwm2Regs.CMPA.half.CMPA       = (last_hardware_prd >> 1);
        EDIS;
    }
}
//角度計算
void p_cal(void)
{
    if (!duty_enable)
    {
        EPwm2Regs.TBPHS.half.TBPHS = (last_hardware_prd - 42);
    }
    d1 = ((last_hardware_prd >> 1) - 21);   //重疊中心點
    a1 = (last_hardware_prd*0.0777778);   //(alpha/180)
}
//電流平均
void Adc_LPF(void)
{
    //  低通濾波
    Iout_filt = (alpha_I * Iout)+ ((1.0 - alpha_I) * Iout_filt);

    Iout_adc_LPF = (alpha_I * Iout_adc)+ ((1.0 - alpha_I) * Iout_adc_LPF);

    Vout_adc_LPF = (0.0006 * Vout_adc)+ ((0.9994) * Vout_adc_LPF1);		//fc=10Hz
    Vout_adc_LPF1 = Vout_adc_LPF;
}

void Adc(void)
{
    EALLOW;
    AdcRegs.ADCCTL2.bit.ADCNONOVERLAP = 1;    // Enable non-overlap mode
    AdcRegs.ADCCTL1.bit.INTPULSEPOS   = 1;    // ADCINT1 trips after AdcResults latch
    AdcRegs.INTSEL1N2.bit.INT1E       = 1;    // enable ADCINT1
    AdcRegs.INTSEL1N2.bit.INT1CONT    = 0;    // Disable ADCINT1 Continuous mode
    AdcRegs.INTSEL1N2.bit.INT1SEL     = 4;    // setup EOC1 to trigger ADCINT1 to fire

    //ADCINA0
    AdcRegs.ADCSOC4CTL.bit.CHSEL      = 4;    // ADCINA4
    AdcRegs.ADCSOC4CTL.bit.TRIGSEL    = 5;    // trigger on EPWM1A
    AdcRegs.ADCSOC4CTL.bit.ACQPS      = 9;    // 10 ADCCLK
    //ADCINA1
    AdcRegs.ADCSOC5CTL.bit.CHSEL      = 5;    // ADCINA5
    AdcRegs.ADCSOC5CTL.bit.TRIGSEL    = 5;    // trigger on EPWM1A
    AdcRegs.ADCSOC5CTL.bit.ACQPS      = 9;    // 10 ADCCLK

    EPwm1Regs.ETSEL.bit.SOCAEN  = 1;
    EPwm1Regs.ETSEL.bit.SOCASEL = 4;
    EPwm1Regs.ETPS.bit.SOCAPRD  = 1;
    EDIS;
}
